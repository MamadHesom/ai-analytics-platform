# Runtime
ENVIRONMENT=development
APP_NAME=AI Analytics Platform API
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security
# Set this in deployment environments; leave blank for local unauthenticated development.
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ML
MODEL_ARTIFACT_PATH=python-backend/artifacts/regression_pipeline.joblib
MODEL_TARGET_COLUMN=target
ANOMALY_CONTAMINATION=0.05

# Request controls
MAX_RECORDS_PER_REQUEST=10000
MAX_TEXTS_PER_REQUEST=1000
